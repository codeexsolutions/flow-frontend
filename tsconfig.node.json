{
  "compilerOptions": {
    "target": "ES2022",
    /* `DOM` entra por causa do `middleware.ts`: ele roda no Edge da Vercel, que
       fala `Request`/`Response`/`fetch` — tipos que vivem na lib do DOM, e não
       na do Node. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `middleware.ts` entra aqui, e a inclusão não é arrumação.
   *
   * Ele fica na raiz, fora de `src`, então o `tsconfig.app.json` não o enxerga
   * — e um arquivo que nenhum `tsconfig` inclui não é verificado por
   * `npm run build`. Ele iria para produção sem ninguém conferir os tipos,
   * interceptando o pedido do documento. Foi exatamente assim que um erro de
   * tipo passou batido e quebrou o build da Vercel hoje.
   */
  "include": ["vite.config.ts", "middleware.ts"]
}
